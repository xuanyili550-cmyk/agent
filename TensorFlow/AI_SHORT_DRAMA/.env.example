# 复制为 .env 后按需修改。全部字段的定义和默认值见 13_INFRA/config.py（Settings）。
# 任何字段都可以用 <NAME>_FILE=/run/secrets/xxx 指向文件读取（Docker/K8s secrets）。

# ---- 运行环境 ----
APP_ENV=dev                      # dev | test | staging | prod（prod 禁止 eager 队列）
LOG_LEVEL=INFO
LOG_JSON=false                   # 生产建议 true
ARTIFACTS_ROOT=./artifacts       # 生成产物（关键帧/成片/manifest/会话历史）根目录

# ---- 数据库 / 队列 ----
DATABASE_URL=sqlite:///./13_infra_dev.db
# DATABASE_URL=postgresql+psycopg2://ai_short_drama:password@postgres:5432/ai_short_drama
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false   # 本地无 Redis 调试时设 true
TASK_MAX_RETRIES=3
TASK_SOFT_TIME_LIMIT_SECONDS=3300
TASK_TIME_LIMIT_SECONDS=3600

# ---- 对象存储 ----
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=./storage_data
# STORAGE_BUCKET=
# STORAGE_ENDPOINT_URL=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=

# ---- LLM ----
LLM_PROVIDER=local               # mock | local | anthropic | openai
# LLM_MODEL=microsoft/Phi-3.5-mini-instruct
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 多模型降级：主模型限流/超时/没配 key 时按顺序切到备用（模型名前缀决定后端：claude*/gpt*/其他=本地）
# LLM_FALLBACK_MODELS=gpt-4o-mini,microsoft/Phi-3.5-mini-instruct
LLM_FALLBACK_COOLDOWN_SECONDS=60 # 失败的模型多久内直接跳过（熔断冷却），到期自动恢复尝试
# 会话历史存储（按优先级取第一个配置了的）：Redis（多 worker）> SQLite（单机可查询）> 本地 JSON 文件
# LLM_CONTEXT_REDIS_URL=redis://localhost:6379/1
# LLM_CONTEXT_SQLITE_PATH=./artifacts/contexts.sqlite3
# LLM_CONTEXT_DIR=./artifacts/contexts
# LLM_CONTEXT_TTL_SECONDS=                          # 不设即永不过期
LLM_CONTEXT_LOCK_TIMEOUT_SECONDS=300

# ---- ToolAgent（工具循环 Agent，如制片助理）----
AGENT_MAX_TOOL_ROUNDS=5          # 一次任务最多调用几次工具（防无限循环）
# AGENT_TOOL_ALLOWLIST=flag_episode_for_human_review   # 允许在 worker 里自动执行的"需确认"工具；不在名单里一律拒绝

# ---- 生成 / QC / 三级重试 ----
IMAGE_BACKEND=dummy              # dummy | diffusers 模型 id（如 stabilityai/stable-diffusion-xl-base-1.0）
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
QC_BACKEND=clip                  # clip | none
QC_MAX_ATTEMPTS=3                # 同参数 -> 改写提示词 -> 降分辨率
QC_CHARACTER_MIN_SIMILARITY=0.75
RETRY_RESOLUTION_LADDER=1080x1920,720x1280,540x960
REQUIRE_HUMAN_REVIEW=true        # 剧本阶段后等人工批准再生产
AI_EDITOR_CAN_APPROVE=false      # true：总编审 Agent 通过即放行

# ---- API ----
API_KEYS=change-me               # 逗号分隔；为空时受保护接口一律 503
RATE_LIMIT_PER_MINUTE=120
# CORS_ORIGINS=https://studio.example.com

# ---- 可观测性 ----
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100

# ---- 发布 ----
PUBLISH_DRY_RUN=true             # 生产显式设 false 才会真的往平台推
PUBLISH_PLATFORMS=youtube,tiktok
# YOUTUBE_CLIENT_SECRETS_PATH=
# YOUTUBE_TOKEN_PATH=
# TIKTOK_ACCESS_TOKEN=

# ---- 付费生成 provider（可选）----
# RUNWAY_API_KEY=
# PIKA_API_KEY=
# ELEVENLABS_API_KEY=
# SYNC_API_KEY=
