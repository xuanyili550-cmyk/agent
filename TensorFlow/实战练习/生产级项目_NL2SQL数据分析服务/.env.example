# 复制为 .env 并按需修改。前缀 APP_ 对应 app/core/config.py 的字段。
APP_ENV=dev
APP_LOG_LEVEL=INFO

# 数据库：本机 SQLite；生产改 MySQL
APP_DATABASE_URL=sqlite:///./nl2sql.db
# APP_DATABASE_URL=mysql+pymysql://user:pwd@mysql:3306/shop
APP_DB_SEED=true

# LLM 后端：stub(测试) / mlx(本机 Mac) / openai(生产, 连 vLLM/Ollama/云端)
APP_LLM_BACKEND=mlx
APP_LLM_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
# 生产(openai 兼容)：
# APP_LLM_BACKEND=openai
# APP_OPENAI_BASE_URL=http://vllm:8000/v1
# APP_OPENAI_API_KEY=EMPTY
# APP_OPENAI_MODEL=qwen

APP_SQL_MAX_RETRIES=2
